# Server-only SearXNG base URL. May include a reverse-proxy path.
# Default when unset: https://search.asynched.tech/
SEARXNG_URL=https://search.asynched.tech/

# Extra sources added to the instance defaults for general searches (no provider filter).
# Set to an empty string to use only the instance defaults. Does not bypass CAPTCHAs/blocks.
SEARXNG_EXTRA_ENGINES=bing,yahoo

# All AI settings are private/runtime-only. Never add a real key to this file.
# AI is disabled by default; both a flag and a server-side key are required.
AI_ENABLED=false
AI_AGENT_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_MODEL=deepseek-v4.1-flash
AI_MAX_STEPS=4
AI_MAX_OUTPUT_TOKENS=1800
